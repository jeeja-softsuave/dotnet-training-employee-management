  "components": {
    "schemas": {
      "ClaimResponse": {
        "required": [
          "type",
          "value"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "CreateDepartmentRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 2,
            "type": "string"
          }
        }
      },
      "CreateEmployeeRequest": {
        "required": [
          "name",
          "type",
          "hireDate"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EmploymentType"
              }
            ]
          },
          "salary": {
            "maximum": 10000000,
            "minimum": 0.01,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "hireDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "departmentId": {
            "maximum": 2147483647,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "contractEndDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          }
        }
      },
      "CurrentUserResponse": {
        "required": [
          "userName",
          "role",
          "claims"
        ],
        "type": "object",
        "properties": {
          "userName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClaimResponse"
            }
          }
        }
      },
      "DepartmentResponse": {
        "required": [
          "id",
          "name",
          "headcount"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "headcount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DepartmentSummary": {
        "required": [
          "departmentId",
          "departmentName",
          "headcount",
          "totalSalary",
          "averageSalary"
        ],
        "type": "object",
        "properties": {
          "departmentId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "departmentName": {
            "type": "string"
          },
          "headcount": {
