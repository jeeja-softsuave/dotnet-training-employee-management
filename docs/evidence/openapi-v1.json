        ],
        "summary": "Gives a percentage raise. HR up to 20%, Admin up to 100%.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
