{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Shows the SQL that EF Core sends to the database.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    },
    "Console": {
      // Development: readable text with scopes (CorrelationId) on each line.
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": true
    // DemoUserPassword comes from user-secrets: see README.
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  }
}
