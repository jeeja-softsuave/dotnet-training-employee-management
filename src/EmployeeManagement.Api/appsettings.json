{
  // Base settings for every environment. Environment files (appsettings.Development.json)
  // override these values. Secrets are NOT stored here: see README "Configuration and secrets".
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      // Production: one JSON object per line, easy for log tools to index (structured logging).
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=employees.db"
  },
  "Database": {
    // Production applies migrations in a deployment step, not at app startup.
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Jwt": {
    "Issuer": "EmployeeManagement.Api",
    "Audience": "EmployeeManagement.Clients",
    "ExpiryMinutes": 60,
    // Secret. Supply via user-secrets (Development) or the Jwt__SigningKey environment variable.
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
